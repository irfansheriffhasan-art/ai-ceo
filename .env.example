# Copy to .env and adjust. Every setting is optional; defaults are shown.
# .env is gitignored — never commit real keys.

# ---- LLM -------------------------------------------------------------------
# ollama (local, default) | anthropic | openai | mock (offline, deterministic)
AICEO_LLM_PROVIDER=ollama
# Demo mode (provider=mock): seconds per simulated model call
# AICEO_MOCK_DELAY_S=1.5
AICEO_LLM_MODEL=llama3.1:8b
# Per-role overrides, e.g. a code model for developers:
# AICEO_LLM_ROLE_MODELS={"frontend": "qwen2.5-coder:7b", "backend": "qwen2.5-coder:7b"}
AICEO_OLLAMA_HOST=http://127.0.0.1:11434
# Keep constant: changing it between calls makes Ollama reload the model.
AICEO_OLLAMA_NUM_CTX=8192
# Local GPUs run one generation at a time.
AICEO_LLM_MAX_CONCURRENCY=1
AICEO_LLM_TIMEOUT_S=600

# Claude (set the provider to anthropic; the model defaults to claude-opus-5-5)
# ANTHROPIC_API_KEY=
# AICEO_ANTHROPIC_EFFORT=medium

# OpenAI or any OpenAI-compatible server
# OPENAI_API_KEY=
# AICEO_OPENAI_BASE_URL=

# ---- Orchestration ---------------------------------------------------------
AICEO_TASK_MAX_ATTEMPTS=3
AICEO_TASK_TIMEOUT_S=1200
AICEO_MAX_PARALLEL_TASKS=3
AICEO_MAX_FIX_ITERATIONS=3
AICEO_REQUIRE_HUMAN_APPROVAL=false

# ---- Server ------------------------------------------------------------------
AICEO_HOST=127.0.0.1
AICEO_PORT=8000
# Generated on first run and stored in data/auth_token when unset. Minimum 16 characters.
# AICEO_AUTH_TOKEN=

# ---- Verification ----------------------------------------------------------
# auto | chromium | msedge | chrome | none
AICEO_BROWSER_CHANNEL=auto
# Generated backends are executed locally (sandboxed env, localhost only) for API tests.
AICEO_RUN_GENERATED_BACKENDS=true

# AICEO_DATA_DIR=./data
